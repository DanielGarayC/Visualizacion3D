        <div><strong>Estilo:</strong></div>     <div>-----</div>
      </div>

      <p style="margin-top: 1.5rem; margin-left: 0.5rem; width: fit-content;">
        <strong style="display: inline-block; width: 120px;">Acciones:</strong>
      </p>      
      <div class="d-flex flex-wrap" style="gap: 10px;">
        <a href="/newModel" class="btn btn-secondary d-flex align-items-center justify-content-center gap-2 custom-btn">
          <i class="mdi mdi-file-pdf"></i> Ficha de ingreso
        </a>
        <a href="/newModel" class="btn btn-secondary d-flex align-items-center justify-content-center gap-2 custom-btn">
          <i class="mdi mdi-file-pdf"></i> Ficha de inventario
        </a>
        <a href="/newModel" class="btn btn-secondary d-flex align-items-center justify-content-center gap-2 custom-btn">
          <i class="mdi mdi-file-pdf"></i> Ficha catalogación
        </a>
        <a href="/newModel" class="btn btn-secondary d-flex align-items-center justify-content-center gap-2 custom-btn">
          <i class="mdi mdi-cube-outline"></i> Ver modelo 3D
        </a>
      </div>
    </div>

  </div>
</div>
      </div> 

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Visualizador FBX</title>

  <!-- Estilos del template -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/assets/vendors/mdi/css/materialdesignicons.min.css">
  <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css">
  <link rel="stylesheet" href="/assets/vendors/jvectormap/jquery-jvectormap.css">
  <link rel="stylesheet" href="/assets/vendors/flag-icon-css/css/flag-icon.min.css">
  <link rel="stylesheet" href="/assets/vendors/owl-carousel-2/owl.carousel.min.css">
  <link rel="stylesheet" href="/assets/vendors/owl-carousel-2/owl.theme.default.min.css">
  <link rel="stylesheet" href="/assets/css/style.css">

  <!-- Three.js y complementos -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/fflate@0.7.4/umd/index.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/FBXLoader.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

  <!-- Iconos y fuente -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{
      font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background:linear-gradient(135deg,#f5f7fa 0%,#e8ecf1 100%);
      min-height:100vh;
    }

    .container-scroller,.page-body-wrapper,.main-panel,.content-wrapper{
      background:transparent !important;color:#1a202c !important;min-height:100vh;
    }
    .content-wrapper{padding:2rem 2.5rem !important;max-width:1800px;margin:0 auto;}

    /* Header: botón izq + título centrado real */
    .page-header{
      display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;margin:0 0 16px;
    }
    .btn-back{
      background:#fff !important;color:#475569 !important;border:2px solid #e2e8f0 !important;
      border-radius:12px;padding:.75rem 1.5rem;font-weight:600;display:inline-flex;align-items:center;gap:.5rem;
      box-shadow:0 4px 12px rgba(0,0,0,.1) !important;transition:.2s ease;
    }
    .btn-back:hover{background:#f8fafc !important;border-color:#cbd5e1 !important;transform:translateX(-2px)}
    .main-title{margin:0;text-align:center;font-size:2.2rem;font-weight:700;color:#111827}
    .header-spacer{visibility:hidden;padding:.75rem 1.5rem;border:2px solid transparent;border-radius:12px}
    @media (max-width:768px){.page-header{grid-template-columns:1fr;gap:8px}.main-title{text-align:left;font-size:1.6rem}.header-spacer{display:none}}

    /* Toolbars */
    .toolbar{
      background:#fff;border-radius:16px;padding:1rem 1.5rem;box-shadow:0 4px 12px rgba(0,0,0,.08);
      border:1px solid rgba(226,232,240,.8);margin-bottom:1.5rem;display:flex;flex-wrap:wrap;
      justify-content:space-between;align-items:center;gap:1rem;
    }
    .toolbar-section{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem}

    .toolbar button,.btn-back,#btn-start-report,#btn-create-area,#btn-undo,#btn-save,#boton-inferior,#boton-descarga{
      border:none;border-radius:12px;padding:.75rem 1.5rem;font-weight:600;font-size:.95rem;
      display:inline-flex;align-items:center;gap:.5rem;cursor:pointer;transition:.25s;
      box-shadow:0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -1px rgba(0,0,0,.06);
    }
    .toolbar button:hover,#btn-start-report:hover,#btn-create-area:hover,#btn-undo:hover,#btn-save:hover,#boton-inferior:hover,#boton-descarga:hover{transform:translateY(-2px)}

    #btn-start-report{background:linear-gradient(135deg,#3b82f6 0%,#2563eb 100%);color:#fff;box-shadow:0 4px 12px -2px rgba(59,130,246,.4)}
    .btn-outline-primary{background:#fff;color:#3b82f6;border:2px solid #3b82f6;border-radius:12px;padding:.6rem 1.1rem}
    .btn-outline-primary:hover{background:#3b82f6;color:#fff}
    .btn-outline-primary.active{background:#3b82f6;color:#fff;border-color:#3b82f6} /* estado activo */
    #btn-create-area{background:linear-gradient(135deg,#10b981 0%,#059669 100%);color:#fff}
    #btn-undo{background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%);color:#fff}
    #btn-save{background:linear-gradient(135deg,#10b981 0%,#059669 100%);color:#fff}
    #boton-inferior{background:linear-gradient(135deg,#3b82f6 0%,#2563eb 100%);color:#fff}
    #boton-descarga{background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%);color:#fff}

    /* Más aire entre herramientas */
    #drawing-tools{ display:none; gap:14px; flex-wrap:wrap; align-items:center }
    .separator{ width:2px; height:30px; background:linear-gradient(180deg,transparent,#e2e8f0,transparent); margin:0 .75rem }
    .toolbar-top .toolbar-section{ gap:1rem }

    /* Card visor */
    .card{background:#fff;border-radius:20px;border:1px solid rgba(226,232,240,.8);
          box-shadow:0 10px 25px -5px rgba(0,0,0,.08),0 8px 10px -6px rgba(0,0,0,.04)}
    .card-body{padding:1.5rem}
    #canvas-container{width:100%;height:70vh;margin:0 auto;border-radius:16px;overflow:hidden;position:relative;
      background:linear-gradient(135deg,#f8fafc 0%,#e2e8f0 100%);box-shadow:inset 0 2px 8px rgba(0,0,0,.08)}
    #view-cube{position:absolute;top:20px;right:20px;width:120px;height:120px;z-index:100;border-radius:16px;
      background:rgba(255,255,255,.9);backdrop-filter:blur(10px);box-shadow:0 8px 16px rgba(0,0,0,.15);cursor:pointer;transition:.25s}
    #view-cube:hover{transform:scale(1.05)}
    @media (max-width:768px){.toolbar{justify-content:center}.toolbar-section{justify-content:center;width:100%}#canvas-container{height:50vh}#view-cube{width:80px;height:80px}}

    /* Color picker UI */
    .color-picker-wrapper{display:inline-flex;align-items:center;gap:.75rem;background:#f8fafc;padding:.5rem 1rem;border-radius:10px;border:2px solid #e2e8f0}
    #color-picker{width:45px;height:35px;border:3px solid #fff;border-radius:8px;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.1)}
  </style>
</head>
<body>
  <div class="container-scroller">
    <%- include('../partials/sidebar') %>
    <div class="container-fluid page-body-wrapper">
      <%- include('../partials/navbar') %>

      <div class="main-panel">
        <div class="content-wrapper">

          <!-- Header -->
          <div class="page-header">
            <a href="/principalAdm" class="btn-back"><i class="fas fa-arrow-left"></i> Regresar</a>
            <h1 class="main-title"><%= nameSculpture %></h1>
            <span class="header-spacer">spacer</span>
          </div>

          <!-- Toolbar superior: reporte/herramientas -->
          <div class="toolbar toolbar-top">
            <div class="toolbar-section">
              <!-- Botón inicial -->
              <button id="btn-start-report"><i class="fas fa-edit"></i> Agregar reporte</button>

              <!-- Herramientas de dibujo (aparecen al iniciar) -->
              <div id="drawing-tools">
                <div class="separator"></div>
                <button id="btn-line-mode" class="btn-outline-primary"><i class="fas fa-pen"></i> Línea</button>
                <button id="btn-area-mode" class="btn-outline-primary"><i class="fas fa-draw-polygon"></i> Área</button>
                <button id="btn-create-area" style="display:none;"><i class="fas fa-check-circle"></i> Crear área</button>

                <div class="separator"></div>
                <div class="color-picker-wrapper">
                  <label for="color-picker"><i class="fas fa-palette"></i> Color</label>
                  <input type="color" id="color-picker" value="#ff0000">
                </div>

                <div class="separator"></div>
                <button id="btn-undo" style="display:none;"><i class="fas fa-undo"></i> Deshacer</button>
                <button id="btn-save" style="display:none;"><i class="fas fa-save"></i> Guardar</button>
                <button id="btn-cancel" class="btn-outline-primary"><i class="fas fa-times"></i> Cancelar</button>
              </div>
            </div>
          </div>

          <!-- Visor 3D -->
          <div class="card" style="width:100%; max-width:1400px; margin:0 auto;">
            <div class="card-body">
              <div id="canvas-container">
                <canvas id="webgl-canvas"></canvas>
                <canvas id="view-cube"></canvas>
              </div>
            </div>
          </div>

          <!-- Toolbar inferior: acciones informativas -->
          <div class="toolbar toolbar-bottom" style="margin-top:1.25rem;">
            <div class="toolbar-section" style="gap:1rem;">
              <button id="boton-inferior"><i class="fas fa-chart-line"></i> Historial ambiental</button>
              <button id="boton-descarga" onclick="descargarPDF()"><i class="fas fa-file-pdf"></i> Acervo documentario</button>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
  <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
  <script src="/assets/vendors/chart.js/Chart.min.js"></script>
  <script src="/assets/vendors/progressbar.js/progressbar.min.js"></script>
  <script src="/assets/vendors/jvectormap/jquery-jvectormap.min.js"></script>
  <script src="/assets/vendors/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
  <script src="/assets/vendors/owl-carousel-2/owl.carousel.min.js"></script>
  <script src="/assets/js/off-canvas.js"></script>
  <script src="/assets/js/hoverable-collapse.js"></script>
  <script src="/assets/js/misc.js"></script>
  <script src="/assets/js/settings.js"></script>
  <script src="/assets/js/todolist.js"></script>
  <script src="/assets/js/dashboard.js"></script>
  <script>
    const fbxPath = "<%= fbxUrl %>";
    const texturePath = "<%= textureUrl %>";
    //console.log(texturePath)
    //Pal pdf
    const indicator = "void";

    //Cubo
    let cubeScene, cubeCamera, cubeRenderer, cubeMesh;
    const cubeCanvas = document.getElementById("view-cube");

    let scene, camera, renderer, modelGroup, controls;
    let baseDistance = 8;
    let currentColor = new THREE.Color(1, 0, 0); // Rojo por defecto

    let lineModeActive = false;
    let areaModeActive = false;
    let clickedPoints = [];
    let areaPoints = [];
    let actions = [];    
    const lineBtn = document.getElementById('btn-line-mode');
    const areaBtn = document.getElementById('btn-area-mode');

    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    init3D();
    initViewCube(); 
    let drawingEnabled = false;

    //Evento de generar Reporte :D
    document.getElementById("btn-start-report").addEventListener("click", () => {
      drawingEnabled = true;
      document.getElementById("drawing-tools").style.display = "inline-flex";
      document.getElementById("btn-start-report").style.display = "none";
      // (opcional) ocultar toolbar inferior durante el reporte:
      document.querySelector('.toolbar-bottom').style.display = 'none';
    });
    document.getElementById("btn-cancel").addEventListener("click", () => {
  // 1) Revertir TODO lo dibujado en esta sesión
  discardAllTemporary();

  // 2) Salir del modo dibujo y resetear UI (igual que antes)
  drawingEnabled = false;
  lineModeActive = false;
  areaModeActive = false;
  clickedPoints = [];
  areaPoints = [];

  document.getElementById('btn-create-area').style.display = "none";
  document.getElementById("drawing-tools").style.display = "none";
  document.getElementById("btn-start-report").style.display = "inline-block";
  document.querySelector('.toolbar-bottom').style.display = '';

  lineBtn.classList.remove('active');
  areaBtn.classList.remove('active');
  document.getElementById("btn-undo").style.display = "none";
  document.getElementById("btn-save").style.display = "none";
});
    lineBtn.addEventListener('click', () => {
      lineModeActive = true;
      areaModeActive = false;
      clickedPoints = [];
      areaPoints = [];
      document.getElementById('btn-create-area').style.display = "none";
      lineBtn.classList.toggle('active', lineModeActive);
      areaBtn.classList.remove('active');
    });

    areaBtn.addEventListener('click', () => {
      areaModeActive = true;
      lineModeActive = false;
      areaPoints = [];
      clickedPoints = [];
      document.getElementById('btn-create-area').style.display = "none";
      areaBtn.classList.toggle('active', areaModeActive);
      lineBtn.classList.remove('active');
    });

    loadFBX(fbxPath, texturePath);


    
    document.getElementById('btn-create-area').addEventListener('click', () => {
      generateAreaFromPoints(areaPoints);
      areaPoints = [];
      areaModeActive = false;
      document.getElementById('btn-create-area').style.display = "none";
    });
    document.getElementById("color-picker").addEventListener("input", (event) => {
      const hex = event.target.value;
      currentColor.set(hex);
    });

    function init3D() {
      const container = document.getElementById('canvas-container');
      const width = container.clientWidth;
      const height = container.clientHeight;

      scene = new THREE.Scene();
      scene.background = new THREE.Color(0xeeeeee);

      camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 2000);
      camera.position.set(0, 2, baseDistance);
      camera.lookAt(new THREE.Vector3(0, 0, 0));

      renderer = new THREE.WebGLRenderer({
        canvas: document.getElementById('webgl-canvas'),
        antialias: true
      });
      renderer.setSize(width, height);

      const directionalLight = new THREE.DirectionalLight(0xffffff, 1);
      directionalLight.position.set(10, 20, -100);
      scene.add(directionalLight);

      const oppositeLight = new THREE.DirectionalLight(0xffffff, 0.5);
      oppositeLight.position.set(10, 20, 100);
      scene.add(oppositeLight);

      const directionalLight1 = new THREE.DirectionalLight(0xffffff, 1);
      directionalLight1.position.set(-10, 20, -100);
      scene.add(directionalLight1);

      const oppositeLight1 = new THREE.DirectionalLight(0xffffff, 0.5);
      oppositeLight1.position.set(-10, 20, 100);
      scene.add(oppositeLight1);

      const toplight = new THREE.DirectionalLight(0xffffff, 0.3);
      toplight.position.set(0, 20, 0);
      scene.add(toplight);

      const ambientLight = new THREE.AmbientLight(0x888888);
      scene.add(ambientLight);

      modelGroup = new THREE.Group();
      scene.add(modelGroup);

      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.rotateSpeed = 0.5;
      controls.minPolarAngle = THREE.MathUtils.degToRad(45);
      controls.maxPolarAngle = THREE.MathUtils.degToRad(120);

      window.addEventListener('resize', () => {
        const width = container.clientWidth;
        const height = container.clientHeight;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      });

      renderer.domElement.addEventListener('click', onCanvasClick);

      animate();
    }

    function onCanvasClick(event) {
      //Para no pintar a menos que se haya seleccionado Agregar Reporte
      if (!drawingEnabled) return;      
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(modelGroup.children, true);

      if (intersects.length > 0) {
        const intersect = intersects[0];
        const clickedPoint = intersect.point.clone();

        if (areaModeActive) {
          areaPoints.push(clickedPoint);
          renderer.render(scene, camera); // actualiza la escena
          if (areaPoints.length === 3) {
            document.getElementById('btn-create-area').style.display = "inline-block";
          }
          if (areaPoints.length === 4) {
            generateAreaFromPoints(areaPoints);
            areaPoints = [];
            areaModeActive = false;
            document.getElementById('btn-create-area').style.display = "none";
          }
          return;
        }

        if (lineModeActive) {
          clickedPoints.push(clickedPoint);
          renderer.render(scene, camera); // actualiza la escena
          if (clickedPoints.length === 2) {
            const interpolated = interpolatePointsOnSurface(clickedPoints[0], clickedPoints[1]);
            drawLineOnSurface(interpolated);
            actualizarBotonesDeAccion();

            // limpiar estado y desactivar botón
            clickedPoints = [];
            lineModeActive = false;
            lineBtn.classList.remove('active');     // 👈 des-selecciona el botón
            areaBtn.classList.remove('active');
            document.getElementById('btn-create-area').style.display = "none";
          }
          return;
        }

        // Color por vértice (modo clic normal)
        const mesh = intersect.object;
        const geometry = mesh.geometry;

        if (!geometry.attributes.color) {
          const count = geometry.attributes.position.count;
          const colors = new Float32Array(count * 3);
          geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
          mesh.material.vertexColors = true;
          mesh.material.needsUpdate = true;
        }

        const positionAttr = geometry.attributes.position;
        const colorAttr = geometry.attributes.color;

        // Guardaremos los cambios para poder revertirlos
        const changes = [];
        for (let i = 0; i < positionAttr.count; i++) {
          const vertex = new THREE.Vector3().fromBufferAttribute(positionAttr, i);
          mesh.localToWorld(vertex);
          const distance = vertex.distanceTo(clickedPoint);

          if (distance < 0.02) {
            // color anterior
            const prev = {
              r: colorAttr.getX(i),
              g: colorAttr.getY(i),
              b: colorAttr.getZ(i)
            };

            // si el nuevo es distinto al anterior, lo registramos
            if (prev.r !== currentColor.r || prev.g !== currentColor.g || prev.b !== currentColor.b) {
              changes.push({ mesh, index: i, prev });
              colorAttr.setXYZ(i, currentColor.r, currentColor.g, currentColor.b);
            }
          }
        }

        if (changes.length > 0) {
          colorAttr.needsUpdate = true;
          actions.push({ type: 'paint', changes });
          actualizarBotonesDeAccion();
        }
      }
    }

    function interpolatePointsOnSurface(p1, p2) {
      const points = [];
      const distance = p1.distanceTo(p2);
      //Cantidad de puntos (dinamica) para las lineas
      const steps = Math.ceil(distance * 40);
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const interp = new THREE.Vector3().lerpVectors(p1, p2, t);
        const dir = new THREE.Vector3().subVectors(interp, camera.position).normalize();
        raycaster.set(camera.position, dir);
        const hits = raycaster.intersectObjects(modelGroup.children, true);
        if (hits.length > 0) {
          points.push(hits[0].point.clone());
        } else {
          points.push(interp.clone());
        }
      }
      return points;
    }

    function paintOnModelAt(point, radius = 0.02) {
  const changes = [];
  modelGroup.traverse((child) => {
    if (!child.isMesh || !child.geometry || !child.geometry.attributes.position) return;

    const geom = child.geometry;
    // Asegurar atributo de color
    if (!geom.attributes.color) {
      const count = geom.attributes.position.count;
      const colors = new Float32Array(count * 3);
      geom.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      child.material.vertexColors = true;
      child.material.needsUpdate = true;
    }

    const pos = geom.attributes.position;
    const col = geom.attributes.color;

    for (let i = 0; i < pos.count; i++) {
      const v = new THREE.Vector3().fromBufferAttribute(pos, i);
      child.localToWorld(v);
      if (v.distanceTo(point) < radius) {
        // guardar color anterior para undo
        const prev = { r: col.getX(i), g: col.getY(i), b: col.getZ(i) };
        if (prev.r !== currentColor.r || prev.g !== currentColor.g || prev.b !== currentColor.b) {
          changes.push({ mesh: child, index: i, prev });
          col.setXYZ(i, currentColor.r, currentColor.g, currentColor.b);
        }
      }
    }
    col.needsUpdate = true;
  });
  return changes;
}

  function drawLineOnSurface(points) {
    const radius = 0.015;               // grosor de la línea pintada
    const allChanges = [];

    for (const p of points) {
      const ch = paintOnModelAt(p, radius);   // usa el helper que ya añadimos
      if (ch.length) allChanges.push(...ch);
    }

    if (allChanges.length) {
      actions.push({ type: 'paint', changes: allChanges }); // undo ya lo revierte completo
      actualizarBotonesDeAccion();
    }
  }

  function generateAreaFromPoints(points) {
    if (points.length < 3) return;

    const surfacePoints = [];
    const triangles = points.length === 3 ? [[0,1,2]] : [[0,1,2], [2,3,0]];

    // muestreamos dentro del triángulo/cuadrilátero y "proyectamos" a la superficie
    const density = 6; // sube a 8–10 si quieres más sólido
    for (const [i1, i2, i3] of triangles) {
      const pA = points[i1], pB = points[i2], pC = points[i3];
      for (let i = 0; i <= density; i++) {
        for (let j = 0; j <= density - i; j++) {
          const a = i / density;
          const b = j / density;
          const c = 1 - a - b;
          const interp = new THREE.Vector3()
            .addScaledVector(pA, a)
            .addScaledVector(pB, b)
            .addScaledVector(pC, c);

          // proyectar hacia la cámara para "pegarlo" a la superficie del modelo
          const dir = new THREE.Vector3().subVectors(interp, camera.position).normalize();
          raycaster.set(camera.position, dir);
          const hits = raycaster.intersectObjects(modelGroup.children, true);
          surfacePoints.push(hits.length > 0 ? hits[0].point.clone() : interp.clone());
        }
      }
    }

    // pintamos vértices alrededor de cada punto muestreado
    const allChanges = [];
    const radius = 0.02; // grosor del “pincel” del área (ajústalo)
    for (const p of surfacePoints) {
      const changes = paintOnModelAt(p, radius);
      if (changes.length) allChanges.push(...changes);
    }

    if (allChanges.length) {
      actions.push({ type: 'paint', changes: allChanges }); // deshacer revierte TODO el área
      actualizarBotonesDeAccion();
    }


    // limpiar estado y desactivar botón
    areaModeActive = false;
    areaPoints = [];
    lineBtn.classList.remove('active');       // 👈 des-selecciona ambos
    areaBtn.classList.remove('active');
    document.getElementById('btn-create-area').style.display = "none";
  }
    //Botones de deshacer y guardar reporte
  function actualizarBotonesDeAccion() {
    const hayPuntos = clickedPoints.length > 0 || areaPoints.length > 0;
    const hayAcciones = actions.length > 0;

    document.getElementById("btn-undo").style.display = (hayPuntos || hayAcciones) ? "inline-block" : "none";
    document.getElementById("btn-save").style.display = (hayPuntos || hayAcciones) ? "inline-block" : "none";
  }

    //Acción para el botón de guardar
    document.getElementById("btn-save").addEventListener("click", () => {
      lineModeActive = false;
      areaModeActive = false;
      drawingEnabled = false;
      clickedPoints = [];
      areaPoints = [];

      document.getElementById('btn-create-area').style.display = "none";
      document.getElementById("btn-undo").style.display = "none";
      document.getElementById("btn-save").style.display = "none";

      // 👉 Esto oculta todos los controles y muestra de nuevo el botón inicial
      document.getElementById("drawing-tools").style.display = "none";
      document.getElementById("btn-start-report").style.display = "inline-block";
      
      document.querySelector('.toolbar-bottom').style.display = '';
      lineBtn.classList.remove('active');
      areaBtn.classList.remove('active');

      alert("✅ Reporte guardado (modo dibujo desactivado).");
    });

    function loadFBX(fbxPath, texturePath) {
      const textureLoader = new THREE.TextureLoader();
      const loader = new THREE.FBXLoader();
      textureLoader.load(texturePath, (texture) => {
        loader.load(fbxPath, (object) => {
          modelGroup.clear();
          object.scale.set(1, 1, 1);
          object.traverse(child => {
            if (child.isMesh) {
              child.material = new THREE.MeshStandardMaterial({
                map: texture,
                side: THREE.DoubleSide,
                metalness: 0.1,
                roughness: 0.8,
                vertexColors: true
              });
            }
          });
          object.rotation.set(-Math.PI / 2, 0, 0);
          const box = new THREE.Box3().setFromObject(object);
          const center = box.getCenter(new THREE.Vector3());
          object.position.sub(center);
          modelGroup.add(object);
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z);
          const fovRadians = (camera.fov * Math.PI) / 180;
          let cameraZ = (maxDim / 2) / Math.tan(fovRadians / 2);
          cameraZ *= 2;
          baseDistance = cameraZ;
          camera.position.set(0, 0, cameraZ);
          camera.lookAt(new THREE.Vector3(0, 0, 0));
          controls.update();
        }, undefined, (error) => {
          console.error("❌ Error al cargar FBX:", error);
        });
      }, undefined, (error) => {
        console.error("❌ Error al cargar la textura:", error);
      });
    }
    //Evento botón deshacer
    document.getElementById("btn-undo").addEventListener("click", () => {
      // 1) Si hay acciones finalizadas (línea/area/paint), deshacer eso primero
      if (actions.length > 0) {
        const last = actions.pop();

        if (last.type === 'line' || last.type === 'area') {
          scene.remove(last.object);
          if (last.object.geometry) last.object.geometry.dispose();
          if (last.object.material) last.object.material.dispose();
        } else if (last.type === 'paint') {
          const touchedGeometries = new Set();
          for (const c of last.changes) {
            const geom = c.mesh.geometry;
            const colorAttr = geom.attributes.color;
            colorAttr.setXYZ(c.index, c.prev.r, c.prev.g, c.prev.b);
            touchedGeometries.add(geom);
          }
          touchedGeometries.forEach(g => g.attributes.color.needsUpdate = true);
        }

        actualizarBotonesDeAccion();
        renderer.render(scene, camera);
        return;
      }

      // 2) Si no hay acciones finalizadas, deshacer puntos pendientes del modo activo
      let hizoAlgo = false;

      if (areaModeActive && areaPoints.length > 0) {
        areaPoints.pop();
        if (areaPoints.length < 3) {
          document.getElementById('btn-create-area').style.display = "none";
        }
        hizoAlgo = true;
      } else if (lineModeActive && clickedPoints.length > 0) {
        clickedPoints.pop();
        hizoAlgo = true;
      }

      if (hizoAlgo) {
        actualizarBotonesDeAccion();
        renderer.render(scene, camera);
      }
    });

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
      if (cubeMesh && camera && cubeRenderer) {
        cubeMesh.quaternion.copy(camera.quaternion).invert();
        cubeRenderer.render(cubeScene, cubeCamera);
      }
    }

    function initViewCube() {
  cubeScene = new THREE.Scene();
  cubeCamera = new THREE.PerspectiveCamera(50, 1, 0.1, 10);
  cubeCamera.position.set(2, 2, 2);
  cubeCamera.lookAt(0, 0, 0);

  const cubeRendererOptions = { canvas: cubeCanvas, alpha: true };
  cubeRenderer = new THREE.WebGLRenderer(cubeRendererOptions);
  cubeRenderer.setSize(100, 100);
  cubeRenderer.setPixelRatio(window.devicePixelRatio);

  // --- Cubo base + bordes ---
  const cubeGeo = new THREE.BoxGeometry();
  const cubeMat = new THREE.MeshStandardMaterial({ color: 0xd3d3d3, flatShading: true });

  const baseCube = new THREE.Mesh(cubeGeo, cubeMat);
  const edgeLines = new THREE.LineSegments(
    new THREE.EdgesGeometry(cubeGeo),
    new THREE.LineBasicMaterial({ color: 0x555555 })
  );
  baseCube.add(edgeLines); // bordes pegados al cubo

  // ====== (AQUÍ VAN LOS EJES Y LAS ETIQUETAS) ======

  // Ejes como flechas (hijos del cubo)
  const axisLen = 0.9, headLen = 0.22, headWidth = 0.12;
  const xArrow = new THREE.ArrowHelper(new THREE.Vector3(1,0,0), new THREE.Vector3(0,0,0), axisLen, 0xff0000, headLen, headWidth);
  const yArrow = new THREE.ArrowHelper(new THREE.Vector3(0,1,0), new THREE.Vector3(0,0,0), axisLen, 0x00ff00, headLen, headWidth);
  const zArrow = new THREE.ArrowHelper(new THREE.Vector3(0,0,1), new THREE.Vector3(0,0,0), axisLen, 0x0000ff, headLen, headWidth);
  baseCube.add(xArrow, yArrow, zArrow);

  // Helper para sprites de texto
  function makeTextSprite(text, color = '#000', fontSize = 64) {
    const canvas = document.createElement('canvas');
    canvas.width = 256; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = color;
    ctx.font = `bold ${fontSize}px Inter, Arial, sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, canvas.width/2, canvas.height/2);

    const texture = new THREE.CanvasTexture(canvas);
    const material = new THREE.SpriteMaterial({ map: texture, transparent: true });
    const sprite = new THREE.Sprite(material);
    sprite.scale.set(0.6, 0.3, 1); // tamaño del rótulo
    return sprite;
  }

  // Sprites X/Y/Z pegados a las puntas de las flechas
  const xLabel = makeTextSprite('X', '#ff0000');
  const yLabel = makeTextSprite('Y', '#00aa00');
  const zLabel = makeTextSprite('Z', '#0000ff');

  xLabel.position.set(axisLen + 0.25, 0, 0);
  yLabel.position.set(0, axisLen + 0.25, 0);
  zLabel.position.set(0, 0, axisLen + 0.25);

  baseCube.add(xLabel, yLabel, zLabel);

  // ====== FIN de ejes + etiquetas ======

  cubeMesh = baseCube;            // lo usas en animate() para copiar la rotación de la cámara
  cubeScene.add(baseCube);
  cubeScene.add(new THREE.AmbientLight(0xffffff, 1));

  // Click en el cubito para orientar la cámara principal
  cubeCanvas.addEventListener("click", (event) => {
    const rect = cubeCanvas.getBoundingClientRect();
    const mouse = new THREE.Vector2(
      ((event.clientX - rect.left) / rect.width) * 2 - 1,
      -((event.clientY - rect.top) / rect.height) * 2 + 1
    );

    const raycaster = new THREE.Raycaster();
    raycaster.setFromCamera(mouse, cubeCamera);

    const intersects = raycaster.intersectObject(baseCube, false); // no recursive
    if (intersects.length > 0 && intersects[0].face) {
      const normal = intersects[0].face.normal.clone().normalize();
      const offset = camera.position.length();
      camera.position.copy(normal.multiplyScalar(offset));
      camera.lookAt(0, 0, 0);
      controls.update();
    }
  });
}


    function descargarPDF() {
      const enlace = document.createElement("a");
      if(indicator=="void"){
        enlace.href = "/pdf/Ficha_Void.pdf";  // Ruta al PDF
        enlace.download = "ficha_escultura_void.pdf";        // Nombre sugerido

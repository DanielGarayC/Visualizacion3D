    function discardAllTemporary() {
  // Recorremos y revertimos TODAS las acciones en orden inverso
  const touchedGeometries = new Set();

  while (actions.length > 0) {
    const last = actions.pop();

    if (last.type === 'line' || last.type === 'area') {
      scene.remove(last.object);
      if (last.object.geometry) last.object.geometry.dispose();
      if (last.object.material) last.object.material.dispose();
    } else if (last.type === 'paint') {
      for (const c of last.changes) {
        const geom = c.mesh.geometry;
        const colorAttr = geom.attributes.color;
        colorAttr.setXYZ(c.index, c.prev.r, c.prev.g, c.prev.b);
        touchedGeometries.add(geom);
      }
    }
  }

  touchedGeometries.forEach(g => g.attributes.color.needsUpdate = true);
  actualizarBotonesDeAccion();
  renderer.render(scene, camera);
}
